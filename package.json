{
  "name": "taste",
  "private": true,
  "bin": {
    "taste": "packages/cli/src/main.ts"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "type": "module",
  "scripts": {
    "test": "bun test",
    "typecheck": "bun scripts/check.ts typecheck",
    "check": "bun scripts/check.ts",
    "check:rules": "./lint/with-real-node.sh --test --test-isolation=none 'lint/**/*.test.ts'",
    "check:structural": "./lint/with-real-node.sh lint/structural/check-structure.ts",
    "lint": "oxlint .",
    "format": "oxfmt .",
    "format:check": "oxfmt --check .",
    "knip": "knip --no-progress",
    "dev:review": "bun run --cwd apps/review dev",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@effect/tsgo": "0.48.0",
    "@modelcontextprotocol/client": "2.4.0",
    "@oxlint/plugins": "^1.89.0",
    "@taste/core": "workspace:*",
    "@types/bun": "1.3.13",
    "@types/node": "26.6.1",
    "effect": "4.0.5",
    "eslint-plugin-sonarjs": "^4.2.2",
    "knip": "^6.43.0",
    "lefthook": "^2.2.2",
    "oxc-parser": "^0.147.0",
    "oxc-resolver": "^11.24.2",
    "oxfmt": "0.64.0",
    "oxlint": "^1.89.0",
    "oxlint-tsgolint": "^7.0.2005",
    "typescript": "7.0.2"
  }
}
