{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "jsPlugins": ["./lint/taste-plugin.ts"],
  "plugins": ["react", "unicorn", "typescript", "oxc", "import", "promise"],
  "ignorePatterns": [".claude/**", ".agent_cache/**", ".tanstack/**", "demo/**", "apps/review/src/routeTree.gen.ts"],
  "options": {
    "typeAware": true,
    "reportUnusedDisableDirectives": "warn"
  },
  "categories": {
    "correctness": "error",
    "suspicious": "error",
    "perf": "error",
    "pedantic": "off",
    "style": "off"
  },
  "rules": {
    "taste/no-long-comments": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-explicit-any": "error",
    "typescript/consistent-type-imports": "error",
    "import/no-cycle": "error",
    "import/no-duplicates": "error",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "group": ["**/packages/*/src/**", "**/apps/*/src/**"],
            "message": "Import another workspace package by name (@taste/core and its subpaths), never by path."
          }
        ]
      }
    ],
    "eqeqeq": "error",
    "react/react-in-jsx-scope": "off",
    "no-underscore-dangle": "off",
    "unicorn/no-array-sort": "off",
    "typescript/consistent-return": "off"
  }
}
